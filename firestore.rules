rules_version = '2';

// Each signed-in person can read and write only their own folder: users/<their uid>/...
// Nobody else (other users, people who are signed out) can see or change it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
