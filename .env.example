# Copy this file to .env for local testing with `vercel dev`.
# Never commit .env. On Vercel, set this in Project → Settings → Environment Variables.
GEMINI_API_KEY=your-new-key-here

# Firebase web config (Firebase console → Project settings → Your apps → Web app → SDK setup and configuration → Config).
# Paste the whole object; JSON or the JS form Firebase shows both work.
FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}
